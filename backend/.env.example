# ======================================================================
# Academia Milla 360 — backend/.env.example
# Copie para backend/.env (a opção 11 do instalar-vps faz isso sozinha,
# preenchendo banco e segredos). backend/.env NUNCA vai para o Git.
# ======================================================================

# -------- Servidor --------
PORT=3000
NODE_ENV=production
CORS_ORIGINS=https://app.academiamilla.tech

# -------- Banco (PostgreSQL na mesma VPS) --------
PGHOST=postgres
PGPORT=5432
PGDATABASE=academiamilla
PGUSER=academiamilla
PGPASSWORD=

# -------- Sessão / autenticação (gerar com: openssl rand -hex 32) --------
JWT_SECRET=
# SESSION_SECRET também cifra a senha do SMTP salva no banco: não troque depois de configurar.
SESSION_SECRET=
APP_URL=https://app.academiamilla.tech

# -------- Arquivos (Cloudflare R2 — bucket privado academia-milla) --------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=academia-milla
R2_REGION=auto

# -------- E-mail de envio --------
# NÃO fica aqui: é configurado pela tela Administração → E-mail de envio (SMTP)
# e salvo no banco (tabela config_email, senha cifrada).
